# 依赖
node_modules/

# 环境变量（API Key 绝对不要提交！）
.env
.env.local

# 日志
*.log
npm-debug.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 构建产物
dist/
build/

# 数据库文件（如果有本地 sqlite）
*.sqlite
*.db

# 运行时生成的数据（每次下单 / 注册都会变，不该提交）
# 这样保证别人 clone 下来是一个干净的、没有测试数据的项目
server/data/orders.json

# 用户和登录会话。
# 【特别注意】这里面存着密码哈希和会话 token，
# 属于敏感数据，绝对不能提交到公开仓库。
server/data/users.json
