{
  "name": "cloudnest-shop",
  "version": "0.3.0",
  "private": true,
  "description": "云巢商城 CloudNest - 一个带 AI 导购助手和 AI 客服的小型电商网站",
  "main": "server/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "test": "npm run test:logic && npm run test:pages && npm run test:auth && npm run test:search && npm run test:runtime && npm run test:auth-ui && npm run test:support && npm run test:write && npm run test:history",
    "test:logic": "node tools/test-agent-logic.js",
    "test:pages": "node tools/test-pages.js",
    "test:auth": "node tools/test-auth.js",
    "test:search": "node tools/test-search.js",
    "test:runtime": "node tools/test-runtime.js",
    "test:auth-ui": "node tools/test-auth-ui.js",
    "test:support": "node tools/test-support.js",
    "test:write": "node tools/test-write-tools.js",
    "test:history": "node tools/test-chat-history.js",
    "eval": "node tools/eval-agent.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
